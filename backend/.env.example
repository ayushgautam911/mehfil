# Copy to `backend/.env` (gitignored) and fill in real values.
PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/hive
JWT_SECRET=change_me_strong_random
QR_SECRET=change_me_strong_random

# ── Email (SMTP) ─────────────────────────────────────────────
# Needed to actually deliver passes. If SMTP_HOST is empty, the app logs
# instead of sending (no-send dev mode).
#
# Example: Spacemail (Spaceship) mailbox — SSL on 465, or STARTTLS on 587.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true          # true for 465 (SSL/TLS); false for 587 (STARTTLS)
SMTP_USER=admin@m3hfil.com
SMTP_PASS=your_mailbox_password
MAIL_FROM=M3HFIL <admin@m3hfil.com>

# ── Event images (GCS) ───────────────────────────────────────
# Bucket for event flyers/covers (not a secret). If empty, image uploads are
# disabled but everything else works. Auth: ADC locally
# (`gcloud auth application-default login`), instance SA on the VM.
GCS_EVENT_IMAGES_BUCKET=your-gcp-project-id-event-images
